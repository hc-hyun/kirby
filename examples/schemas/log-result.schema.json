{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic log triage PoC result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "status",
    "summary",
    "observations",
    "hypotheses",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "role": {
      "const": "log-analyst"
    },
    "status": {
      "enum": [
        "ok",
        "insufficient_data"
      ]
    },
    "summary": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "line_start",
          "line_end",
          "description"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
