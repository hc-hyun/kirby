KIRBY_DATABASE_URL=postgresql://kirby:kirby@127.0.0.1:5432/kirby
KIRBY_ROLES_DIR=agents
KIRBY_SESSIONS_DIR=.local/sessions
KIRBY_GOOSE_BINARY=.tools/goose
KIRBY_MODEL=cohere/north-mini-code:free
KIRBY_OPENROUTER_KEY_FILE=/absolute/path/to/open_router.key
KIRBY_CREDENTIALS_FILE=/absolute/path/to/api_credentials.json
KIRBY_PUBLIC_URL=http://127.0.0.1:8000
KIRBY_WORKER_ID=worker-1
# Optional MinIO; leave endpoint unset to keep file handling disabled.
KIRBY_MINIO_ENDPOINT=http://127.0.0.1:9000
KIRBY_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
KIRBY_MINIO_CREDENTIALS_FILE=/absolute/path/to/my-minio/.env
